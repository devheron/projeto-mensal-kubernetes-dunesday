# O projeto roda sem este arquivo. Todos os valores abaixo ja tem padrao
# embutido no docker-compose.yaml.
#
# Crie um .env apenas se precisar trocar alguma coisa, por exemplo uma porta
# que ja esteja ocupada na sua maquina:
#
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# O .env fica fora do Git. Somente este modelo e versionado.


# ---------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------
# Credenciais do MongoDB local. O banco escuta apenas na rede interna
# do Docker e nao guarda nada sensivel, entao os padroes servem.
# No Kubernetes estes valores vem do Secret, nunca de arquivo.
MONGO_USER=dunesday
MONGO_PASSWORD=dunesday_local
MONGO_DB=todo-app


# ---------------------------------------------------------------
# Portas publicadas no host
# ---------------------------------------------------------------
# Escolhidas para nao colidir com o projeto anterior, que usa
# 80, 5000 e 27017. Troque aqui se alguma estiver ocupada.
FRONTEND_PORT=8080
BACKEND_PORT=5001
MONGO_PORT=27018


# ---------------------------------------------------------------
# API
# ---------------------------------------------------------------
# Origem liberada no CORS. Precisa bater com o endereco de onde a
# pagina e servida durante o npm start.
# Em producao o navegador chama /api no mesmo host e o CORS nao entra.
CORS_ORIGIN=http://localhost:3000
